QUERYPILOT_ENVIRONMENT=development
QUERYPILOT_DATABASE_URL=postgresql://querypilot_app:querypilot_app_dev@localhost:5432/querypilot
QUERYPILOT_STATEMENT_TIMEOUT_MS=3000
QUERYPILOT_FOUNDRY_CHAT_MODEL=qwen2.5-1.5b
QUERYPILOT_FOUNDRY_EMBEDDING_MODEL=qwen3-embedding-0.6b
QUERYPILOT_GENERATION_REPAIR_CUTOFF_SECONDS=8
QUERYPILOT_ANALYSIS_TTL_SECONDS=900
QUERYPILOT_WORKLOAD_MIN_CALLS=2
